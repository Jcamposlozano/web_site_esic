---
import Layout from "../layouts/Layout.astro";

/**
 * Confirmación de pago de inscripción.
 * Réplica de https://esic.co/confirmacion-pago-inscripcion/ con el estilo
 * de las páginas de confirmación del repo.
 */

const title = "Pago de inscripción recibido — ESIC Medellín";
const description =
  "Hemos recibido tu pago de inscripción. Gracias por confiar en ESIC Medellín.";
---
<Layout title={title} description={description}>
  <main class="bg-bg py-16 md:py-24">
    <div class="mx-auto w-full max-w-[720px] px-5">
      <div
        role="status"
        aria-live="polite"
        class="rounded-[18px] border border-[rgba(0,19,63,0.12)] bg-white p-8 text-center shadow-[0_12px_32px_rgba(2,6,23,0.07)] md:p-12"
      >
        <span
          aria-hidden="true"
          class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-full border border-[rgba(255,135,1,0.35)] bg-[rgba(255,135,1,0.12)] text-brand-orange-alt"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </span>
        <span class="mb-2 inline-block text-[0.75rem] font-bold uppercase tracking-[0.16em] text-brand-orange-alt">
          Formulario enviado
        </span>
        <h1 class="font-display text-[clamp(1.9rem,5vw,2.6rem)] font-extrabold uppercase leading-[1.05] tracking-[0.01em] text-brand-blue-dark">
          Hemos recibido<br />tu pago de inscripción
        </h1>
        <p class="mx-auto mt-4 max-w-[48ch] text-ink-muted">
          Gracias por confiar en ESIC. Te enviaremos la confirmación y los siguientes
          pasos a tu correo electrónico.
        </p>
        <div class="mt-8">
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-blue-dark bg-brand-blue-dark px-8 py-3.5 text-[0.9rem] font-bold uppercase tracking-[0.05em] text-white no-underline transition-all hover:-translate-y-px hover:bg-[#001a52]"
          >
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";

/**
 * Confirmación de inscripción — Level Up con Claude.
 * Réplica de https://esic.co/confirmacion-level-up-claude/ con el patrón
 * de open-day/confirmacion.astro.
 */

const title = "¡Ya tienes tu cupo! — Level Up con Claude | ESIC Medellín";
const description =
  "Tu pago está confirmado y tu cupo en Level Up con Claude está asegurado. Sábados 22 y 29 de agosto y 5 de septiembre de 2026, 8:00 a 12:00, Campus ESIC Medellín.";

const waUrl =
  "https://wa.me/573160108050?text=%C2%A1Hola!%20Tengo%20una%20duda%20sobre%20mi%20inscripci%C3%B3n%20al%20Level%20Up%20con%20Claude.";

const detalles = [
  { label: "Fechas", value: "22 · 29 AGO — 5 SEP" },
  { label: "Horario", value: "8:00 a 12:00 · 3 sábados" },
  { label: "Lugar", value: "Presencial — Campus ESIC Medellín" },
  { label: "Lleva", value: "Tu laptop y tus ganas" },
];

const pasos = [
  {
    n: 1,
    title: "Revisa tu correo",
    body: "Te enviamos la confirmación de inscripción y el recibo del pago. Si no lo ves, revisa la carpeta de spam.",
  },
  {
    n: 2,
    title: "Agenda las fechas",
    body: "Bloquea los 3 sábados (22 y 29 de agosto, 5 de septiembre) de 8:00 a 12:00 en el Campus ESIC Medellín.",
  },
  {
    n: 3,
    title: "Prepárate",
    body: "Lleva tu computador portátil. No necesitas saber programar: solo venir con ganas de construir.",
  },
];
---
<Layout title={title} description={description}>
  <main class="bg-bg py-16 md:py-24">
    <div class="mx-auto w-full max-w-[880px] px-5">
      <div
        role="status"
        aria-live="polite"
        class="rounded-[18px] border border-[rgba(0,19,63,0.12)] bg-white p-7 shadow-[0_12px_32px_rgba(2,6,23,0.07)] md:p-8"
      >
        <!-- Head -->
        <div class="flex items-start gap-[18px] border-b border-[rgba(0,19,63,0.12)] pb-[18px]">
          <span
            aria-hidden="true"
            class="grid h-12 w-12 flex-none place-items-center rounded-full border border-[rgba(217,119,87,0.4)] bg-[rgba(217,119,87,0.12)] text-[#c25f3f]"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <div>
            <span class="mb-1 inline-block text-[0.72rem] font-bold uppercase tracking-[0.16em] text-[#c25f3f]">
              Pago confirmado
            </span>
            <h1 class="font-display text-[1.75rem] font-extrabold uppercase leading-[1.05] tracking-[0.01em] text-brand-blue-dark">
              ¡Ya tienes tu cupo!
            </h1>
            <p class="mt-2 text-ink-muted">
              Bienvenido al <strong class="text-brand-blue-dark">Level Up con Claude</strong>.
              Recibimos tu pago y tu lugar está asegurado. Nos vemos para construir tu negocio
              real, de una idea a algo publicado.
            </p>
          </div>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 gap-4 pt-5 md:grid-cols-2">
          <!-- Detalles -->
          <section class="rounded-[14px] border border-[rgba(0,19,63,0.12)] bg-[#FAFAF8] px-5 py-[18px]" aria-labelledby="detalles">
            <h2 id="detalles" class="mb-3 font-display text-[1.25rem] font-extrabold uppercase tracking-[0.01em] text-brand-blue-dark">
              Detalles del curso
            </h2>
            {detalles.map((d) => (
              <p class="my-2 text-[0.95rem] leading-[1.5] text-[#334155]">
                <span class="text-[0.75rem] font-bold uppercase tracking-[0.08em] text-[#64748B]">{d.label}</span><br />
                <strong class="font-bold text-brand-blue-dark">{d.value}</strong>
              </p>
            ))}
          </section>

          <!-- Próximos pasos -->
          <section class="rounded-[14px] border border-[rgba(0,19,63,0.12)] bg-[#FAFAF8] px-5 py-[18px]" aria-labelledby="pasos">
            <h2 id="pasos" class="mb-3 font-display text-[1.25rem] font-extrabold uppercase tracking-[0.01em] text-brand-blue-dark">
              Próximos pasos
            </h2>
            <ol class="m-0 flex list-none flex-col gap-3 p-0">
              {pasos.map((p) => (
                <li class="flex items-start gap-3">
                  <span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-brand-blue-dark text-[0.8rem] font-bold text-white">{p.n}</span>
                  <div>
                    <strong class="block text-[0.95rem] font-bold text-brand-blue-dark">{p.title}</strong>
                    <span class="text-[0.9rem] leading-[1.5] text-[#334155]">{p.body}</span>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        </div>

        <!-- Acciones -->
        <div class="mt-5 flex flex-wrap items-center gap-2.5 border-t border-[rgba(0,19,63,0.12)] pt-5">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-blue-dark bg-brand-blue-dark px-[18px] py-[11px] text-[0.85rem] font-bold tracking-[0.04em] text-white no-underline transition-all hover:-translate-y-px hover:bg-[#001a52]"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[15px] w-[15px] flex-none">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            Escríbenos por WhatsApp
          </a>
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-blue-dark bg-white px-[18px] py-[11px] text-[0.85rem] font-bold tracking-[0.04em] text-brand-blue-dark no-underline transition-all hover:-translate-y-px hover:bg-brand-blue-dark hover:text-white"
          >
            Volver a esic.co
          </a>
          <p class="w-full pt-1 text-[0.9rem] text-ink-muted md:w-auto md:pt-0">
            ¿Dudas con tu inscripción? Escríbenos y con gusto te ayudamos.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

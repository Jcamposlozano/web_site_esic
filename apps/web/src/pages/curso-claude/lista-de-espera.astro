---
import Layout from "../../layouts/Layout.astro";

/**
 * Confirmación de lista de espera — Level Up con Claude.
 * La edición de agosto/septiembre 2026 quedó SOLD OUT: el formulario de Zoho
 * ya no redirige a Wompi, sino aquí. El lead queda en el CRM para avisarle
 * primero cuando abramos la siguiente edición.
 */

const title = "Estás en la lista de espera — Level Up con Claude | ESIC Medellín";
const description =
  "Recibimos tus datos. La edición actual de Level Up con Claude está agotada; te avisaremos primero cuando abramos cupos para la próxima.";

const waUrl =
  "https://wa.me/573160108050?text=%C2%A1Hola!%20Quiero%20saber%20cu%C3%A1ndo%20abre%20la%20pr%C3%B3xima%20edici%C3%B3n%20del%20Level%20Up%20con%20Claude.";

const pasos = [
  {
    n: 1,
    title: "Ya estás registrado",
    body: "Tus datos quedaron en nuestra base. No tienes que hacer nada más ni realizar ningún pago.",
  },
  {
    n: 2,
    title: "Te avisamos primero",
    body: "Cuando abramos fechas para la próxima edición, la lista de espera es la primera en enterarse y en poder separar cupo.",
  },
  {
    n: 3,
    title: "Revisa tu correo y WhatsApp",
    body: "Te contactaremos por el medio que nos indicaste. Si tienes dudas, escríbenos cuando quieras.",
  },
];
---
<Layout title={title} description={description}>
  <main class="bg-bg py-16 md:py-24">
    <div class="mx-auto w-full max-w-[880px] px-5">
      <div
        role="status"
        aria-live="polite"
        class="rounded-[18px] border border-[rgba(0,19,63,0.12)] bg-white p-7 shadow-[0_12px_32px_rgba(2,6,23,0.07)] md:p-8"
      >
        <!-- Head -->
        <div class="flex items-start gap-[18px] border-b border-[rgba(0,19,63,0.12)] pb-[18px]">
          <span
            aria-hidden="true"
            class="grid h-12 w-12 flex-none place-items-center rounded-full border border-[rgba(217,119,87,0.4)] bg-[rgba(217,119,87,0.12)] text-[#c25f3f]"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <div>
            <span class="mb-1 inline-block text-[0.72rem] font-bold uppercase tracking-[0.16em] text-[#c25f3f]">
              Datos recibidos
            </span>
            <h1 class="font-display text-[1.75rem] font-extrabold uppercase leading-[1.05] tracking-[0.01em] text-brand-blue-dark">
              Estás en la lista de espera
            </h1>
            <p class="mt-2 text-ink-muted">
              La edición actual del <strong class="text-brand-blue-dark">Level Up con Claude</strong>
              está agotada, pero ya guardamos tus datos. Serás de los primeros en enterarte
              cuando abramos cupos para la próxima.
            </p>
          </div>
        </div>

        <!-- Próximos pasos -->
        <section class="pt-5" aria-labelledby="pasos">
          <h2 id="pasos" class="mb-3 font-display text-[1.25rem] font-extrabold uppercase tracking-[0.01em] text-brand-blue-dark">
            ¿Qué sigue?
          </h2>
          <ol class="m-0 flex list-none flex-col gap-3 p-0">
            {pasos.map((p) => (
              <li class="flex items-start gap-3">
                <span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-brand-blue-dark text-[0.8rem] font-bold text-white">{p.n}</span>
                <div>
                  <strong class="block text-[0.95rem] font-bold text-brand-blue-dark">{p.title}</strong>
                  <span class="text-[0.9rem] leading-[1.5] text-[#334155]">{p.body}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Acciones -->
        <div class="mt-5 flex flex-wrap items-center gap-2.5 border-t border-[rgba(0,19,63,0.12)] pt-5">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-blue-dark bg-brand-blue-dark px-[18px] py-[11px] text-[0.85rem] font-bold tracking-[0.04em] text-white no-underline transition-all hover:-translate-y-px hover:bg-[#001a52]"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[15px] w-[15px] flex-none">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            Escríbenos por WhatsApp
          </a>
          <a
            href="/programas/"
            class="inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] border-brand-blue-dark bg-white px-[18px] py-[11px] text-[0.85rem] font-bold tracking-[0.04em] text-brand-blue-dark no-underline transition-all hover:-translate-y-px hover:bg-brand-blue-dark hover:text-white"
          >
            Ver otros programas
          </a>
          <p class="w-full pt-1 text-[0.9rem] text-ink-muted md:w-auto md:pt-0">
            Mientras tanto, mira los demás programas de ESIC Medellín.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

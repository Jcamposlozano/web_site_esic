---
/**
 * /executive-program — Executive Program en Human AI-First Leadership
 * (réplica fiel de executive-programs/elementor-widget.html).
 *
 * Antes vivía en /digital-business-transformation; esa ruta queda como redirect
 * (ver astro.config.mjs) porque es la que circuló y quedó indexada.
 *
 * Hero = banner-image responsive (mobile/desktop) que enlaza a #contacto.
 * El cuerpo vive en ExecutiveProgramBody.
 *
 * fullBleed: el hero es un banner a ancho completo y el cuerpo usa el patrón
 * de overlap propio del widget (stats bar -50px, etc.), igual que el original.
 */
import Layout from "../layouts/Layout.astro";
import ExecutiveProgramBody from "../components/pages/programas/ExecutiveProgramBody.astro";
import { asset } from "../lib/assets";

/**
 * Banner propio del Executive Program (antes se usaba, por error, el del
 * Pregrado en Digital Business). Vive en el bucket de assets como el resto:
 * `prisma-fai-admin` → src/esic-website/assets/wp/2026/08/.
 * Ver design/executive-banner/README.md.
 */
const EXEC_BANNER_DESKTOP = asset(
  "wp/2026/08/banner-executive-human-ai-first-leadership-desktop.webp",
);
const EXEC_BANNER_MOBILE = asset(
  "wp/2026/08/banner-executive-human-ai-first-leadership-mobile.webp",
);
---
<Layout
  title="Executive Program en Human AI-First Leadership — ESIC Medellín"
  description="Executive Program en Human AI-First Leadership: 4 meses, 2h por semana, inmersión de 4 días en Madrid. Cocreado por ESIC, Prestigio y Accenture."
  fullBleed
>
  <main class="exec-program-widget">
    <!-- Hero Banner -->
    <section class="exec__hero-banner">
      <!-- El titular vive dentro del banner (imagen), así que el h1 de la
           página va aquí para SEO y lectores de pantalla. -->
      <h1 class="exec__sr-title">
        Executive Program en Human AI-First Leadership — ESIC Medellín
      </h1>
      <a href="#contacto" aria-label="Solicitar información del Executive Program en Human AI-First Leadership">
        <picture>
          <source media="(max-width: 768px)" srcset={EXEC_BANNER_MOBILE} type="image/webp" />
          <source media="(min-width: 769px)" srcset={EXEC_BANNER_DESKTOP} type="image/webp" />
          <img
            src={EXEC_BANNER_DESKTOP}
            alt="Executive Program en Human AI-First Leadership — ESIC, Prestigio y Accenture"
            loading="eager"
          />
        </picture>
      </a>
    </section>

    <ExecutiveProgramBody withForm />
  </main>
</Layout>

<style>
  .exec-program-widget { color: #0B132B; }
  .exec__hero-banner { position: relative; width: 100%; }
  .exec__sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .exec__hero-banner a { display: block; width: 100%; }
  .exec__hero-banner img { width: 100%; height: auto; display: block; }
</style>

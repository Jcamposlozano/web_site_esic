---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import { asset } from "../lib/assets";

const title = "Desafío Junior Empresarial × Action Black — ESIC Medellín";
const description =
  "El mejor gimnasio del mundo busca a los próximos líderes de ESIC. Arma tu equipo, resuelve el reto real de Action Black y gánate una beca de hasta el 50% para tu primer año. 12 de septiembre, campus ESIC Medellín.";

const FORM_ACTION =
  "https://forms.zohopublic.com/esicmedellin/form/RegistrateenelDesafioJuniorEmpresarialESIC/formperma/NiOec1N0j5twOPruyoIuTLyE1n2AnU6OxgcnlCZu9cc/htmlRecords/submit";

const AB_LOGO = asset("dje/action-black-logo-white.svg");
// Logo oficial de ESIC en blanco sobre transparente (el de brand/ es azul
// sobre fondo blanco opaco y no sirve para el hero oscuro)
const ESIC_LOGO = asset("wp/2026/02/logo-esic.png");
const HERO_PHOTO = asset("dje/hero-action-black.webp");
const CAMPANA_VIDEO = asset("dje/dje-video-campana.mp4");
const CAMPANA_POSTER = asset("dje/dje-video-poster.webp");

const HEADLINE = "El mejor gimnasio del mundo busca a los próximos líderes de ESIC".split(" ");
// Palabras 5..10 ("busca a los próximos líderes") van en azul
const isBlue = (i: number) => i >= 5 && i <= 9;

const MARQUEE = [
  "El mejor gimnasio del mundo",
  "La escuela #1 de marketing y negocios digitales",
  "Un solo reto, una beca real",
  "12 de septiembre · Campus ESIC",
];

const steps = [
  {
    num: "01",
    title: "Arma tu equipo",
    body: "Solo o con hasta 4 integrantes. ¿No tienes con quién? Desde ESIC te ayudamos a armar tu equipo.",
  },
  {
    num: "02",
    title: "Resuelve el reto real",
    body: "Un caso real de Action Black, el mejor gimnasio del mundo. Ideas, estrategia y ejecución en un solo día.",
  },
  {
    num: "03",
    title: "Gánate la beca",
    body: "1er puesto: beca del 50%. 2do puesto: beca del 20%. Para el primer año de pregrado, para cada integrante.",
  },
];

const infoItems = [
  {
    label: "Fecha",
    value: "12 de septiembre",
    icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  },
  {
    label: "Horario",
    value: "9:00 a.m. — 2:00 p.m.",
    icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
  },
  {
    label: "Lugar",
    value: "Campus ESIC Medellín · Mall La Reserva",
    icon: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
  },
  {
    label: "Experiencia",
    value: "Action Black en vivo dentro del campus",
    icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
  },
];

const requisitos = [
  "Exclusivo para estudiantes de colegio de los grados 10, 11 y 12",
  "Participa solo o en equipos de máximo 4 personas",
  "Si no tienes equipo, desde ESIC te lo armamos",
  "No aplica para estudiantes de pregrado, posgrado ni programas ejecutivos",
];

const checkIcon = `<polyline points="20 6 9 17 4 12"/>`;
const arrowIcon = `<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>`;
---
<Layout title={title} description={description} fullBleed>
  <main class="esic-dje bg-[#0A0A0A] text-white">
    <!-- ── HERO — tipografía cinética ── -->
    <section class="dje-hero relative isolate flex min-h-[92vh] items-center overflow-hidden bg-[#0A0A0A]">
      <div class="absolute inset-0 z-0">
        <img
          src={HERO_PHOTO}
          alt="Entrenamiento en Action Black"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.72)_0%,rgba(0,0,0,0.55)_45%,rgba(10,10,10,0.96)_100%)]"></div>
      </div>

      <Container class="relative z-[2] max-w-[1140px]">
        <div class="flex flex-col items-start py-32 md:py-36">
          <span class="dje-kicker mb-6">
            <em class="text-[#FF9600] not-italic font-extrabold">[</em>&nbsp; Desafío Junior Empresarial &nbsp;<em class="text-[#FF9600] not-italic font-extrabold">]</em>
          </span>

          <div class="mb-7 flex items-center gap-4">
            <img src={ESIC_LOGO} alt="ESIC Business & Marketing School" class="h-11 w-auto" width="800" height="350" loading="eager" />
            <span class="text-[1.1rem] font-light text-white/50">×</span>
            <img src={AB_LOGO} alt="Action Black" class="h-9 w-auto" loading="eager" />
          </div>

          <h1 class="dje-kinetic mb-6 max-w-[820px] font-display text-[clamp(3.4rem,8vw,7.5rem)] font-extrabold uppercase leading-[0.94] tracking-[-0.01em]">
            {HEADLINE.map((w, i) => (
              <span class={isBlue(i) ? "text-[#5B8AFF]" : ""} style={`animation-delay:${i * 0.1}s`}>{w}&nbsp;</span>
            ))}
          </h1>

          <p class="mb-4 max-w-[560px] text-[clamp(1rem,1.6vw,1.15rem)] leading-[1.7] text-white/[0.72]">
            Desafío Junior Empresarial × Action Black. Arma tu equipo, resuelve el reto y gánate una beca real.
          </p>

          <p class="mb-9 dje-kicker-line">Hecho para ti, que todavía estás en el colegio</p>

          <div class="mb-10 flex flex-wrap gap-x-8 gap-y-3">
            <span class="dje-datum">12 sep · 9am–2pm</span>
            <span class="dje-datum">Becas del 50% y 20%</span>
          </div>

          <a
            href="#inscripcion"
            class="inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-[#0047E9] bg-[#0047E9] px-[2.6rem] py-[1.15rem] text-[0.9rem] font-bold uppercase tracking-[0.08em] text-white no-underline transition-all hover:-translate-y-0.5 hover:border-[#0038B8] hover:bg-[#0038B8]"
          >
            Postúlate ahora
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]" set:html={arrowIcon} />
          </a>
        </div>
      </Container>
    </section>


    <!-- ── INSCRIPCIÓN — split con countdown ── -->
    <section id="inscripcion" class="relative z-[2] -mt-[50px] rounded-t-[50px] bg-[#0047E9] py-20 md:py-24">
      <Container class="max-w-[1140px]">
        <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_1.15fr]">
          <!-- Columna premio + countdown -->
          <div class="dje-reveal flex flex-col gap-6 lg:sticky lg:top-28">
            <span class="dje-kicker-line !text-white/[0.85]" style="--kline: rgba(255,255,255,0.85);">Inscripciones abiertas</span>
            <h2 class="font-display text-[clamp(2.8rem,5.5vw,4.6rem)] font-extrabold uppercase leading-[0.96] text-white">
              Gánate el <span class="text-[#FF9600]">50%</span> de tu primer año
            </h2>
            <p class="max-w-[440px] text-[1.05rem] leading-[1.65] text-white/[0.85]">
              Diligencia el formulario y postúlate antes de que se cierren las inscripciones. Cupos limitados.
            </p>
            <div class="flex gap-2.5" id="dje-cd-mini" data-target="2026-09-12T09:00:00-05:00">
              {["Días", "Hrs", "Min"].map((l) => (
                <div class="min-w-[74px] rounded-[12px] border border-white/[0.25] bg-white/[0.1] px-3 py-2.5 text-center">
                  <div class="dje-cd-n font-display text-[1.7rem] font-extrabold leading-none text-white">—</div>
                  <div class="mt-0.5 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-white/[0.6]">{l}</div>
                </div>
              ))}
            </div>
            <p class="text-[0.85rem] font-bold uppercase tracking-[0.12em] text-white/[0.65]">12 de septiembre · Campus ESIC Medellín</p>
          </div>

          <!-- Formulario -->
          <div class="dje-reveal rounded-[24px] bg-white p-8 shadow-[0_24px_60px_rgba(0,19,63,0.35)] md:p-10">
          <form
            action={FORM_ACTION}
            name="form"
            id="dje-form"
            method="POST"
            accept-charset="UTF-8"
            enctype="multipart/form-data"
            class="flex flex-col gap-5"
          >
            <input type="hidden" name="zf_referrer_name" value="" />
            <input type="hidden" name="zf_redirect_url" value="https://esic.co/desafio-junior-empresarial/confirmacion/" />
            <input type="hidden" name="zc_gad" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="utm_adset_name" value="" />
            <input type="hidden" name="utm_ad_name" value="" />

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label for="dje-nombre" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Nombre <em class="text-[#E5484D] not-italic">*</em></label>
                <input id="dje-nombre" type="text" maxlength="255" name="Name_First" required class="dje-input" placeholder="Tu nombre" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="dje-apellidos" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Apellidos <em class="text-[#E5484D] not-italic">*</em></label>
                <input id="dje-apellidos" type="text" maxlength="255" name="Name_Last" required class="dje-input" placeholder="Tus apellidos" />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="dje-email" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Correo electrónico <em class="text-[#E5484D] not-italic">*</em></label>
              <input id="dje-email" type="email" maxlength="255" name="Email" required class="dje-input" placeholder="tucorreo@ejemplo.com" />
            </div>

            <div class="grid grid-cols-[110px_1fr] gap-4">
              <div class="flex flex-col gap-1.5">
                <label for="dje-codigo" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Código</label>
                <input id="dje-codigo" type="text" name="PhoneNumber_countrycodeval" maxlength="10" value="+57" class="dje-input" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="dje-telefono" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Móvil o teléfono <em class="text-[#E5484D] not-italic">*</em></label>
                <input id="dje-telefono" type="tel" name="PhoneNumber_countrycode" maxlength="20" required class="dje-input" placeholder="300 000 0000" />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="dje-colegio" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Institución educativa <em class="text-[#E5484D] not-italic">*</em></label>
              <input id="dje-colegio" type="text" name="SingleLine4" maxlength="255" required class="dje-input" placeholder="Nombre de tu colegio" />
            </div>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
              <div class="flex flex-col gap-1.5">
                <label for="dje-grado" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Grado <em class="text-[#E5484D] not-italic">*</em></label>
                <select id="dje-grado" name="Dropdown" required class="dje-input">
                  <option value="" selected disabled>Selecciona</option>
                  <option value="Decimo">Décimo</option>
                  <option value="Once">Once</option>
                  <option value="Doce">Doce</option>
                  <option value="Recién graduado">Recién graduado</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="dje-programa" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Programa de interés <em class="text-[#E5484D] not-italic">*</em></label>
                <select id="dje-programa" name="Dropdown1" required class="dje-input">
                  <option value="" selected disabled>Selecciona</option>
                  <option value="Digital Buisiness">Digital Business</option>
                  <option value="Dirección de Marketing Global">Dirección de Marketing Global</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="dje-periodo" class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-brand-blue-dark">Periodo de interés <em class="text-[#E5484D] not-italic">*</em></label>
                <select id="dje-periodo" name="Dropdown2" required class="dje-input">
                  <option value="" selected disabled>Selecciona</option>
                  <option value="2026-2">2026-2</option>
                  <option value="2027-1">2027-1</option>
                  <option value="2027-2">2027-2</option>
                  <option value="2028-1">2028-1</option>
                </select>
              </div>
            </div>

            <div class="mt-1 flex flex-col gap-3">
              <label class="flex items-start gap-3 text-[0.88rem] leading-[1.5] text-ink-muted">
                <input type="checkbox" name="DecisionBox2" required class="dje-check" />
                <span>
                  Acepto el <a href="https://esic.co/politicas-de-privacidad/" target="_blank" rel="noopener" class="font-semibold text-brand-blue underline">tratamiento de datos personales</a>
                  por parte de ESIC Business &amp; Marketing School Campus Medellín – Prisma Colombia. <em class="text-[#E5484D] not-italic">*</em>
                </span>
              </label>
              <label class="flex items-start gap-3 text-[0.88rem] leading-[1.5] text-ink-muted">
                <input type="checkbox" name="DecisionBox" class="dje-check" />
                <span>Deseo mantenerme informado a través de email y teléfono sobre novedades formativas, por ESIC Business &amp; Marketing School Campus Medellín.</span>
              </label>
              <label class="flex items-start gap-3 text-[0.88rem] leading-[1.5] text-ink-muted">
                <input type="checkbox" name="DecisionBox1" class="dje-check" />
                <span>Acepto que el emisor conozca si abro sus emails, desde qué dispositivos y cuándo, así como si interactúo con ellos, con la única finalidad de que pueda mejorar sus acciones comerciales.</span>
              </label>
            </div>

            <button
              type="submit"
              class="mt-2 inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-brand-blue bg-brand-blue px-[2.6rem] py-[1.15rem] text-[0.9rem] font-bold uppercase tracking-[0.08em] text-white transition-all hover:-translate-y-0.5 hover:border-brand-blue-dark hover:bg-brand-blue-dark"
            >
              Postularme al desafío
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]" set:html={arrowIcon} />
            </button>
          </form>
          </div>
        </div>
      </Container>
    </section>
    <!-- ── QUÉ ES — borde luminoso ── -->
    <section class="relative z-[3] -mt-[50px] rounded-t-[50px] bg-[#111214] py-20 md:py-24">
      <Container class="max-w-[1100px]">
        <div class="dje-reveal mx-auto max-w-[760px] text-center">
          <span class="dje-kicker-line mx-auto mb-4 justify-center">¿Qué es el desafío?</span>
          <h2 class="mb-6 font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[1] text-white">
            El reto de negocios más real antes de la universidad
          </h2>
          <p class="text-[clamp(1rem,1.5vw,1.12rem)] leading-[1.8] text-white/[0.68]">
            El Desafío Junior Empresarial es el reto de negocios más real que vas a vivir antes de la universidad.
            Esta vez lo pone <strong class="text-white">Action Black, el mejor gimnasio del mundo</strong>: tú y tu
            equipo van a resolver un caso real de una marca real. Si no tienes equipo, desde ESIC te ayudamos a armarlo.
          </p>
        </div>

        <div class="dje-reveal mt-14 grid grid-cols-1 gap-5 md:grid-cols-3">
          {steps.map((s, i) => (
            <div class="dje-mb-card" style={`animation-delay:-${i}s`}>
              <div class="dje-mb-inner flex h-full flex-col gap-3 p-7">
                <span class="font-display text-[1.8rem] font-extrabold text-white/[0.16]">{s.num}</span>
                <h3 class="font-display text-[1.6rem] font-extrabold uppercase leading-[1.05] text-white">{s.title}</h3>
                <p class="text-[0.98rem] leading-[1.6] text-white/[0.62]">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- ── VIDEO DE CAMPAÑA ── -->
    <section class="relative z-[4] -mt-[50px] rounded-t-[50px] bg-[#0A0A0A] py-20 md:py-24">
      <Container class="max-w-[1100px]">
        <div class="dje-reveal mb-10 text-center">
          <span class="dje-kicker-line mx-auto mb-4 justify-center">El desafío en video</span>
          <h2 class="font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[1] text-white">
            Así se vive el reto
          </h2>
        </div>

        <div class="dje-reveal relative mx-auto max-w-[980px] overflow-hidden rounded-[24px] bg-black shadow-[0_24px_60px_rgba(0,0,0,0.45)]">
          <video
            class="block aspect-video h-auto w-full"
            src={CAMPANA_VIDEO}
            poster={CAMPANA_POSTER}
            controls
            playsinline
            preload="none"
            aria-label="Video de campaña del Desafío Junior Empresarial × Action Black"
          ></video>
        </div>
      </Container>
    </section>

    <!-- ── PREMIOS — contador animado ── -->
    <section class="relative z-[5] -mt-[50px] rounded-t-[50px] bg-[#0A0A0A] py-20 md:py-24">
      <Container class="max-w-[1100px]">
        <div class="dje-reveal mb-12 text-center">
          <span class="dje-kicker-line mx-auto mb-4 justify-center">Premios</span>
          <h2 class="font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[1] text-white">
            Becas reales para tu primer año
          </h2>
          <p class="mx-auto mt-3 max-w-[620px] text-[1.02rem] leading-[1.65] text-white/[0.62]">
            Aplican para el primer año en los pregrados en doble titulación de ESIC Medellín:
            Digital Business y Dirección de Marketing Global.
          </p>
        </div>

        <div class="dje-reveal mx-auto grid max-w-[900px] grid-cols-1 gap-6 md:grid-cols-2">
          <div class="relative overflow-hidden rounded-[24px] border border-[rgba(0,71,233,0.5)] bg-[linear-gradient(150deg,rgba(0,71,233,0.22)_0%,rgba(10,10,10,0.4)_60%)] p-9">
            <span class="mb-2 block text-[0.78rem] font-bold uppercase tracking-[0.2em] text-[#5B8AFF]">1er puesto</span>
            <div class="mb-3 font-display text-[clamp(4.5rem,9vw,6.5rem)] font-extrabold leading-none text-white"><span class="dje-tick" data-to="50">0</span><span class="text-[#0047E9]">%</span></div>
            <p class="text-[1rem] leading-[1.6] text-white/[0.72]">
              Beca del 50% para el primer año de pregrado en ESIC, para <strong class="text-white">cada integrante</strong> del equipo ganador.
            </p>
          </div>
          <div class="relative overflow-hidden rounded-[24px] border border-[rgba(255,150,0,0.45)] bg-[linear-gradient(150deg,rgba(255,150,0,0.16)_0%,rgba(10,10,10,0.4)_60%)] p-9">
            <span class="mb-2 block text-[0.78rem] font-bold uppercase tracking-[0.2em] text-[#FF9600]">2do puesto</span>
            <div class="mb-3 font-display text-[clamp(4.5rem,9vw,6.5rem)] font-extrabold leading-none text-white"><span class="dje-tick" data-to="20">0</span><span class="text-[#FF9600]">%</span></div>
            <p class="text-[1rem] leading-[1.6] text-white/[0.72]">
              Beca del 20% para el primer año de pregrado en ESIC, para <strong class="text-white">cada integrante</strong> del equipo.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- ── FECHA Y LUGAR — countdown ── -->
    <section class="relative z-[6] -mt-[50px] rounded-t-[50px] bg-[#111214] py-20 md:py-24">
      <Container class="max-w-[1100px]">
        <div class="dje-reveal mb-12 text-center">
          <span class="dje-kicker-line mx-auto mb-4 justify-center">Fecha y lugar</span>
          <h2 class="font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[1] text-white">
            Una jornada completa
          </h2>
          <p class="mx-auto mt-3 max-w-[620px] text-[1.02rem] leading-[1.65] text-white/[0.62]">
            Con una experiencia de marca de Action Black en vivo dentro del campus: zona de activación, música y luces.
          </p>
        </div>

        <div class="dje-reveal mx-auto mb-12 flex max-w-[640px] items-stretch justify-center gap-3.5 md:gap-4" id="dje-cd" data-target="2026-09-12T09:00:00-05:00">
          {["Días", "Horas", "Min", "Seg"].map((l) => (
            <div class="min-w-[86px] flex-1 rounded-[16px] border border-white/[0.12] bg-white/[0.05] px-2 py-4 text-center md:min-w-[104px]">
              <div class="dje-cd-n font-display text-[clamp(2.4rem,5vw,3.2rem)] font-extrabold leading-none text-white">—</div>
              <div class="mt-1.5 text-[0.7rem] font-bold uppercase tracking-[0.18em] text-white/[0.5]">{l}</div>
            </div>
          ))}
        </div>

        <div class="dje-reveal mx-auto grid max-w-[980px] grid-cols-1 gap-[1.1rem] min-[520px]:grid-cols-2 md:grid-cols-4">
          {infoItems.map((it) => (
            <div class="rounded-[18px] border border-white/[0.08] bg-white/[0.03] p-6 transition-all hover:-translate-y-1 hover:border-white/[0.18]">
              <div class="mb-4 grid h-11 w-11 place-items-center rounded-[11px] bg-[rgba(255,150,0,0.14)] text-[#FF9600]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[22px] w-[22px]" set:html={it.icon} />

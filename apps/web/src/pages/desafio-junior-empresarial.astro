            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]" set:html={arrowIcon} />
          </a>
        </div>
      </Container>
    </section>
  </main>
</Layout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var form = document.getElementById("dje-form");
    if (form) {
      ["utm_source","utm_medium","utm_campaign","utm_term","utm_content","utm_adset_name","utm_ad_name"].forEach(function (k) {
        var v = params.get(k);
        if (v) {
          var input = form.querySelector('input[name="' + k + '"]');
          if (input) input.value = v;
        }
      });
    }

    function tickCountdown(el) {
      var target = new Date(el.dataset.target).getTime();
      var cells = el.querySelectorAll(".dje-cd-n");
      function upd() {
        var d = Math.max(0, target - Date.now()) / 1000;
        var vals = [Math.floor(d / 86400), Math.floor(d / 3600 % 24), Math.floor(d / 60 % 60), Math.floor(d % 60)];
        cells.forEach(function (c, i) {
          c.textContent = i === 0 ? String(vals[0]) : String(vals[i]).padStart(2, "0");
        });
      }
      upd();
      setInterval(upd, 1000);
    }
    document.querySelectorAll("#dje-cd, #dje-cd-mini").forEach(tickCountdown);

    var ticked = false;
    var tickObs = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting || ticked) return;
        ticked = true;
        document.querySelectorAll(".dje-tick").forEach(function (el) {
          var to = +el.dataset.to;
          var t0 = performance.now();
          function step(t) {
            var p = Math.min((t - t0) / 1400, 1);
            el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3)));
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        });
      });
    }, { threshold: 0.4 });
    var firstTick = document.querySelector(".dje-tick");
    if (firstTick) tickObs.observe(firstTick.closest("section") || firstTick);

    var revObs = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add("dje-in"); revObs.unobserve(e.target); }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll(".dje-reveal").forEach(function (el) { revObs.observe(el); });
  })();
</script>


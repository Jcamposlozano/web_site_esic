---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import { asset } from "../lib/assets";

/**
 * Level Up con Claude — Domina Claude en 3 sesiones.
 * Paleta fiel al elementor original (level-up-claude-elementor.html):
 * fondo #0A0A0A, acento clay #D97757, crema #F4EDE4, secciones claras
 * #F5F2EC (tutores) y #F8F6F2 (pilares).
 */

const title = "Level Up con Claude — Domina Claude en 3 sesiones | ESIC Medellín";
const description =
  "De consumir IA a crear con ella. Domina los 4 pilares de Claude (Chat, Cowork, Design y Code) en 3 sábados presenciales en el Campus ESIC Medellín y sal con tu negocio publicado. Inversión: $1.200.000 COP.";

/**
 * Flujo de inscripción (igual al de la landing original de WordPress):
 * CTA → modal con formulario Zoho (captura el lead) → Zoho redirige a Wompi
 * vía zf_redirect_url → pago → /curso-claude/confirmacion.
 * El lead queda registrado aunque la persona no complete el pago.
 */
const WOMPI_URL = "https://checkout.wompi.co/l/RCCkA3";
const ZOHO_ACTION =
  "https://forms.zohopublic.com/esicmedellin/form/SeparayatulugarFormularioLevelUP110226/formperma/6suw077ABDvaL9ciYTgezsHxpmtBh6y2URfr6ZDbCGU/htmlRecords/submit";

const UTM_FIELDS = [
  "utm_source",
  "utm_medium",
  "utm_campaign",
  "utm_term",
  "utm_content",
  "utm_adset_name",
  "utm_ad_name",
];

const tiposDocumento = [
  "Tarjeta de identidad",
  "Cédula de ciudadanía",
  "Cédula de extranjería",
  "Pasaporte",
];

const mediosContacto = ["WhatsApp", "Correo", "Llamada"];

const fuentes = [
  "Instagram",
  "Facebook",
  "Google",
  "LinkedIn",
  "Página Web",
  "Ferias y eventos",
  "Referidos",
  "WhatsApp",
  "TikTok",
];

const stats = [
  { label: "Fechas", a: "22 · 29 AGO", b: "5 SEP" },
  { label: "Horario", a: "8:00 a 12:00", b: "3 sábados" },
  { label: "Modalidad", a: "Presencial", b: "Campus Medellín" },
  { label: "Te llevas", a: "Tu negocio", b: "publicado" },
];

const tutores = [
  {
    nombre: "Juan Esteban Jaramillo",
    foto: asset("wp/2026/07/level-up-tutor-juan-esteban.webp"),
    bio: "Líder de los programas ejecutivos de Inteligencia Artificial en ESIC Medellín y presidente de la institución. Ha liderado la formación en IA aplicada a la estrategia empresarial.",
  },
  {
    nombre: "Jerónimo Martínez",
    foto: asset("wp/2026/07/level-up-tutor-jeronimo.webp"),
    bio: "Experto en implementación de soluciones de inteligencia artificial en ESIC Medellín. Lidera el desarrollo tecnológico de la institución.",
  },
];

const pilares = [
  {
    name: "Chat",
    session: "Sesión 01",
    body: "Prompting efectivo, contexto e investigación de mercado. Aprendes a hacer las preguntas correctas.",
    icon: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
  },
  {
    name: "Cowork",
    session: "Sesión 02",
    body: "Colabora con agentes en tareas y flujos de trabajo reales para acelerar tu proyecto.",
    icon: `<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/>`,
  },
  {
    name: "Design",
    session: "Sesión 02",
    body: "Identidad visual y manual de marca reutilizable a partir de tu concepto.",
    icon: `<circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="10.5" r="2.5"/><circle cx="8.5" cy="7.5" r="2.5"/><circle cx="6.5" cy="12.5" r="2.5"/><path d="M12 22a3 3 0 0 0 3-3v-7"/>`,
  },
  {
    name: "Code",
    session: "Sesión 03",
    body: "Publica tu sitio con base de datos real — sin escribir una sola línea de código.",
    icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  },
];

const sesiones = [
  {
    n: "01",
    day: "Día 1",
    date: "22 AGO",
    pilar: "Claude Chat",
    tema: "Contexto y prompting",
    items: [
      "Fundamentos de Claude y buen contexto",
      "Prompting efectivo para resultados reales",
      "Investigación de mercado del sector café",
    ],
  },
  {
    n: "02",
    day: "Día 2",
    date: "29 AGO",
    pilar: "Claude Cowork",
    tema: "Competencia y marca",
    items: [
      "Análisis de competencia con IA",
      "Concepto y posicionamiento de marca",
      "Diseño de identidad y manual reutilizable",
    ],
  },
  {
    n: "03",
    day: "Día 3",
    date: "5 SEP",
    pilar: "Claude Code",
    tema: "Construcción y despliegue",
    items: [
      "Sitio web conectado a base de datos",
      "Tienda de café funcional",
      "Publicación y puesta en marcha",
    ],
  },
];

const entregables = [
  {
    title: "Tienda publicada",
    body: "Tu tienda funcional y en línea, con base de datos real.",
    icon: `<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>`,
  },
  {
    title: "Manual de marca",
    body: "Identidad reutilizable: logo, colores, tono y lineamientos.",
    icon: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  },
  {
    title: "Kit de prompts",
    body: "Prompts y herramientas personalizadas para seguir creando.",
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
  },
];

const checkIcon = `<polyline points="20 6 9 17 4 12"/>`;
---
<Layout title={title} description={description} fullBleed>
  <main class="esic-curso-claude bg-[#0A0A0A] text-[#F4EDE4]">
    <!-- ═══ HERO BANNER ═══ -->
    <section class="relative z-[1] block overflow-hidden bg-[#0B0B0C] pb-[54px] pt-[88px] leading-[0] md:pt-0">
      <h1 class="sr-only">Level Up con Claude — Domina Claude en 3 sesiones · ESIC Medellín</h1>
      <a href="#inscripcion" aria-label="Separa tu cupo en Level Up con Claude" class="block">
        <picture>
          <source media="(max-width: 767px)" srcset={asset("wp/2026/07/level-up-hero-mobile.webp")} type="image/webp" />
          <img
            src={asset("wp/2026/07/level-up-hero-desktop.webp")}
            alt="Level Up con Claude — Domina Claude en 3 sesiones. Usar Claude es fácil, dominarlo no. 22 ago / 29 ago / 05 sep."
            class="block h-auto w-full align-bottom"
            fetchpriority="high"
            width="2400"
            height="1095"
          />
        </picture>
      </a>
    </section>

    <!-- ═══ PRECIO + STATS (panel oscuro con glow) ═══ -->
    <section class="cc-stats relative z-[2] -mt-[54px] rounded-t-[50px] pb-16">
      <Container class="max-w-[1100px]">
        <div class="flex flex-wrap items-center justify-between gap-6 pb-10 pt-12">
          <div class="flex flex-col">
            <strong class="font-display text-[2.1rem] font-extrabold leading-none text-white">$1.200.000</strong>
            <span class="mt-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#D97757]">COP · Cupos limitados</span>
          </div>
          <div class="flex flex-wrap gap-3">
            <button
              type="button"
              class="cc-open-modal inline-flex items-center justify-center gap-2 rounded-full border-0 bg-[#D97757] px-8 py-3.5 text-[0.9rem] font-bold uppercase tracking-[0.05em] text-[#1a0e08] no-underline shadow-[0_10px_34px_rgba(217,119,87,0.34)] transition-all hover:-translate-y-0.5 hover:bg-[#E88C6D]"
            >
              Separa tu cupo →
            </button>
            <a
              href="#agenda"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-[rgba(244,237,228,0.35)] px-8 py-3.5 text-[0.9rem] font-bold uppercase tracking-[0.05em] text-[#F4EDE4] no-underline transition-all hover:-translate-y-0.5 hover:bg-[#F4EDE4] hover:text-[#1a0e08]"
            >
              Ver el programa
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4">
          {stats.map((s, i) => (
            <div class={"px-5 py-8 text-center " + (i > 0 ? "cc-stat-border " : "") + (i >= 2 ? "cc-stat-top" : "")}>
              <span class="mb-2.5 block text-[0.66rem] font-bold uppercase tracking-[0.16em] text-[rgba(244,237,228,0.74)]">{s.label}</span>
              <b class="block font-display text-[clamp(1.25rem,2.1vw,1.6rem)] font-extrabold uppercase leading-[1.12] text-white">{s.a}<br />{s.b}</b>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══ TUTORES (fondo claro) ═══ -->
    <section class="relative z-[3] -mt-[50px] rounded-t-[50px] bg-[#F5F2EC] py-20 text-[#141210] md:py-24">
      <Container class="max-w-[1100px]">
        <h2 class="cc-reveal font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[0.94] tracking-[-0.01em]">
          Tus <span class="text-[#D97757]">tutores</span>
        </h2>

        <div class="mt-11 grid grid-cols-1 gap-6 md:grid-cols-2">
          {tutores.map((t) => (
            <div class="cc-reveal cc-tutor flex items-center gap-6 rounded-[22px] border border-[rgba(20,18,16,0.1)] bg-white p-7 shadow-[0_12px_34px_rgba(20,18,16,0.08)] transition-all max-md:flex-col max-md:text-center">
              <img
                src={t.foto}
                alt={t.nombre}
                loading="lazy"
                width="208"
                height="208"
                class="h-[104px] w-[104px] flex-none rounded-full border-2 border-[#D97757] bg-[#EDE8E0] object-cover"
              />
              <div>
                <span class="mb-1 block text-[0.66rem] font-bold uppercase tracking-[0.16em] text-[#c25f3f]">Con:</span>
                <b class="mb-2 block font-display text-[1.55rem] font-extrabold uppercase leading-none text-[#141210]">{t.nombre}</b>
                <p class="text-[0.9rem] leading-[1.6] text-[rgba(20,18,16,0.66)]">{t.bio}</p>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══ LOS 4 PILARES (claro con tinte azul) ═══ -->
    <section class="cc-eco relative z-[4] -mt-[50px] rounded-t-[50px] py-20 text-[#00133F] md:py-24">
      <Container class="max-w-[1100px]">
        <span class="cc-reveal cc-kicker">De consumir IA a crear con ella</span>
        <h2 class="cc-reveal font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[0.94] tracking-[-0.01em] text-[#00133F]">
          Los <span class="text-[#D97757]">4 pilares</span> de Claude
        </h2>
        <p class="cc-reveal mt-5 max-w-[640px] text-[1.08rem] leading-[1.75] text-[rgba(0,19,63,0.66)]">
          No aprendes una herramienta suelta: dominas el ecosistema completo de Claude para
          investigar, colaborar, diseñar y publicar. Tres sesiones, cuatro pilares, un negocio real lanzado.
        </p>

        <div class="mt-11 grid grid-cols-2 gap-3 md:gap-5 lg:grid-cols-4">
          {pilares.map((p, i) => (
            <article class="cc-reveal cc-card cc-pil rounded-[18px] bg-white p-4 shadow-[0_10px_30px_rgba(0,19,63,0.07)] transition-all md:p-7" style={`--pd:${i * 0.65}s`}>
              <div class="mb-3 grid h-[42px] w-[42px] place-items-center rounded-[12px] bg-[linear-gradient(135deg,#D97757,#FF7A2F)] text-white shadow-[0_8px_20px_rgba(217,119,87,0.35)] md:mb-4 md:h-[46px] md:w-[46px]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-[20px] w-[20px] md:h-[22px] md:w-[22px]" set:html={p.icon} />
              </div>
              <h3 class="font-display text-[1.3rem] font-extrabold uppercase tracking-[0.01em] text-[#00133F] md:text-[1.5rem]">{p.name}</h3>
              <p class="mt-1.5 text-[0.84rem] leading-[1.5] text-[rgba(0,19,63,0.66)] md:mt-2 md:text-[0.93rem]">{p.body}</p>
              <span class="mt-3 inline-block rounded-full bg-[rgba(0,19,63,0.06)] px-3 py-1 text-[0.66rem] font-bold uppercase tracking-[0.12em] text-[#00133F] md:mt-4 md:text-[0.7rem]">{p.session}</span>
            </article>
          ))}
        </div>

        <div class="cc-reveal relative z-[6] mx-auto -mb-[110px] mt-10 w-[290px]" id="cc-mascot-wrap">
          <img
            src={asset("wp/2026/07/mascota-claude.webp")}
            alt="Mascota de Claude saludando"
            loading="lazy"
            width="640"
            height="640"
            class="cc-mascot block h-auto w-full drop-shadow-[0_24px_48px_rgba(0,0,0,0.45)]"
          />
        </div>
      </Container>
    </section>

    <!-- ═══ CTA (debajo de la mascota) ═══ -->
    <section class="cc-close relative z-[5] -mt-[50px] rounded-t-[50px] pb-20 pt-36 text-center">
      <Container class="max-w-[760px]">
        <div class="cc-reveal">
          <h2 class="font-display text-[clamp(2.8rem,7vw,5rem)] font-extrabold uppercase leading-[0.9] text-white">
            Deja de mirar la IA<br />y <span class="text-[#D97757]">empieza a construir</span>
          </h2>
          <p class="mx-auto mt-6 max-w-[520px] text-[1.1rem] leading-[1.7] text-[rgba(244,237,228,0.74)]">
            Cupos limitados. Asegura tu lugar y sal con tu negocio publicado.
          </p>
          <p class="mb-6 mt-8 inline-flex items-baseline gap-2">
            <b class="font-display text-[3rem] font-extrabold leading-none text-white">$1.200.000</b>
            <span class="text-[0.8rem] font-semibold uppercase tracking-[0.1em] text-[#D97757]">COP</span>
          </p>
          <div>
            <button
              type="button"
              class="cc-open-modal inline-flex items-center justify-center gap-2 rounded-full border-0 bg-[#D97757] px-9 py-4 text-[0.9rem] font-bold uppercase tracking-[0.05em] text-[#1a0e08] no-underline shadow-[0_10px_34px_rgba(217,119,87,0.34)] transition-all hover:-translate-y-0.5 hover:bg-[#E88C6D]"
            >
              Separa tu cupo →
            </button>
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══ AGENDA ═══ -->
    <section id="agenda" class="relative z-[6] -mt-[50px] rounded-t-[50px] bg-[#0C0A08] py-20 md:py-24">
      <Container class="max-w-[1100px]">
        <span class="cc-reveal cc-kicker">Programa · 2026</span>
        <h2 class="cc-reveal font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[0.94] tracking-[-0.01em] text-white">
          Construye tu tienda en <span class="text-[#D97757]">3 sesiones</span>
        </h2>
        <p class="cc-reveal mt-5 max-w-[640px] text-[1.08rem] leading-[1.75] text-[rgba(244,237,228,0.74)]">
          Presencial en Medellín. Cada sesión suma una capa hasta tener tu marca de café
          publicada y funcionando.
        </p>

        <div class="mt-11 grid grid-cols-1 gap-5 md:grid-cols-3">
          {sesiones.map((s) => (
            <article class="cc-reveal cc-ses rounded-[18px] border border-[rgba(244,237,228,0.14)] bg-[rgba(244,237,228,0.04)] p-7 transition-all">
              <div class="mb-5 flex items-center justify-between border-b border-[rgba(244,237,228,0.14)] pb-4">
                <span class="font-display text-[2.6rem] font-extrabold leading-none text-[rgba(244,237,228,0.18)]">{s.n}</span>
                <span class="text-right text-[0.7rem] font-bold uppercase tracking-[0.12em] text-[rgba(244,237,228,0.6)]">
                  {s.day}<b class="block text-[0.95rem] text-white">{s.date}</b>
                </span>
              </div>
              <span class="text-[0.72rem] font-bold uppercase tracking-[0.14em] text-[#D97757]">{s.pilar}</span>
              <h3 class="mt-1 font-display text-[1.5rem] font-extrabold uppercase leading-[1.05] text-white">{s.tema}</h3>
              <ul class="mt-4 flex flex-col gap-2.5">
                {s.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-[0.95rem] leading-[1.5] text-[rgba(244,237,228,0.72)]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-[3px] h-4 w-4 flex-none text-[#D97757]" set:html={checkIcon} />
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══ ENTREGABLES ═══ -->
    <section class="relative z-[7] -mt-[50px] rounded-t-[50px] bg-[#0A0A0A] py-20 md:py-24">
      <Container class="max-w-[1100px]">
        <span class="cc-reveal cc-kicker">Te llevas resultados, no solo apuntes</span>
        <h2 class="cc-reveal font-display text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold uppercase leading-[0.94] tracking-[-0.01em] text-white">
          Lo que <span class="text-[#D97757]">sales construyendo</span>
        </h2>

        <div class="mt-11 grid grid-cols-1 gap-5 md:grid-cols-3">
          {entregables.map((e) => (
            <article class="cc-reveal cc-ses rounded-[18px] border border-[rgba(244,237,228,0.14)] bg-[rgba(244,237,228,0.04)] p-8 transition-all">
              <div class="mb-4 grid h-[52px] w-[52px] place-items-center rounded-[14px] bg-[rgba(217,119,87,0.16)] text-[#E89B82]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={e.icon} />
              </div>
              <h3 class="font-display text-[1.35rem] font-extrabold uppercase text-white">{e.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-[1.55] text-[rgba(244,237,228,0.72)]">{e.body}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══ INSCRIPCIÓN / PAGO (cierre) ═══ -->
    <section id="inscripcion" class="cc-close relative z-[8] -mt-[50px] rounded-t-[50px] py-20 text-center md:py-24">
      <Container class="max-w-[760px]">
        <div class="cc-reveal">
          <span class="cc-kicker justify-center">Inscríbete al Level Up</span>
          <h2 class="font-display text-[clamp(2.8rem,7vw,5rem)] font-extrabold uppercase leading-[0.9] text-white">
            Tu cupo te <span class="cc-gradtext">está esperando</span>
          </h2>
          <p class="mx-auto mt-6 max-w-[520px] text-[1.1rem] leading-[1.7] text-[rgba(244,237,228,0.74)]">
            Cupos limitados · 22, 29 ago y 5 sep · Presencial en Campus ESIC Medellín.
            Completa tu inscripción y continúa al pago seguro con Wompi.
          </p>
          <p class="relative mb-6 mt-8 inline-flex items-baseline gap-2" id="cc-price-final">
            <b class="font-display text-[3rem] font-extrabold leading-none text-white">$1.200.000</b>
            <span class="text-[0.8rem] font-semibold uppercase tracking-[0.1em] text-[#D97757]">COP</span>
          </p>
          <div>
            <button
              type="button"
              class="cc-open-modal cc-shine inline-flex items-center justify-center gap-2 rounded-full border-0 bg-[#D97757] px-9 py-4 text-[0.9rem] font-bold uppercase tracking-[0.05em] text-[#1a0e08] no-underline shadow-[0_10px_34px_rgba(217,119,87,0.34)] transition-all hover:-translate-y-0.5 hover:bg-[#E88C6D]"
            >
              Separa tu cupo →
            </button>
          </div>
          <p class="mt-5 text-[0.85rem] text-[rgba(244,237,228,0.5)]">
            Pago seguro con Wompi · Al confirmar el pago tu lugar queda asegurado
          </p>
        </div>
      </Container>
    </section>

    <!-- ═══ MODAL DE INSCRIPCIÓN (lead primero, pago después) ═══ -->
    <div
      class="cc-modal-overlay fixed inset-0 z-[9999] items-start justify-center overflow-y-auto bg-[rgba(10,10,10,0.78)] px-4 py-8 backdrop-blur-sm"
      id="cc-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cc-modal-title"
    >
      <div class="cc-modal-box relative w-full max-w-[560px] rounded-[22px] bg-white p-7 shadow-[0_30px_80px_rgba(0,0,0,0.5)] md:p-9">
        <button
          type="button"
          class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full border-0 bg-[rgba(20,18,16,0.06)] text-[1.5rem] leading-none text-[#141210] transition-colors hover:bg-[rgba(20,18,16,0.12)]"
          id="cc-modal-close"
          aria-label="Cerrar"
        >&#215;</button>

        <div class="mb-6 pr-10">
          <h2 id="cc-modal-title" class="font-display text-[2rem] font-extrabold uppercase leading-none text-[#00133F]">
            Inscríbete al Level Up
          </h2>
          <p class="mt-1.5 text-[0.92rem] leading-[1.5] text-[rgba(20,18,16,0.62)]">
            Completa tus datos y continúa al pago seguro con Wompi.
          </p>
        </div>

        <form
          action={ZOHO_ACTION}
          id="cc-form"
          method="POST"
          accept-charset="UTF-8"
          enctype="multipart/form-data"

<script is:inline>
  (function () {
    var reveals = document.querySelectorAll(".esic-curso-claude .cc-reveal");
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add("cc-in");
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add("cc-in"); });
    }

    // Modal de inscripcion: captura el lead en Zoho antes de mandar a Wompi
    var modal = document.getElementById("cc-modal");
    if (modal) {
      var form = document.getElementById("cc-form");
      var lastFocus = null;

      var openModal = function () {
        lastFocus = document.activeElement;
        modal.classList.add("cc-modal-open");
        document.body.style.overflow = "hidden";
        var first = modal.querySelector('input:not([type="hidden"]), select');
        if (first) first.focus();
      };

      var closeModal = function () {
        modal.classList.remove("cc-modal-open");
        document.body.style.overflow = "";
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      };

      document.querySelectorAll(".cc-open-modal").forEach(function (btn) {
        btn.addEventListener("click", openModal);
      });
      document.getElementById("cc-modal-close").addEventListener("click", closeModal);
      modal.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.classList.contains("cc-modal-open")) closeModal();
      });

      // UTMs de la URL -> campos ocultos del form de Zoho
      var params = new URLSearchParams(window.location.search);
      ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "utm_adset_name", "utm_ad_name"].forEach(
        function (param) {
          var value = params.get(param);
          if (!value) return;
          modal.querySelectorAll('[name="' + param + '"]').forEach(function (input) {
            input.value = value;
          });
        }
      );

      // Evita doble envio mientras Zoho procesa y redirige a Wompi
      if (form) {
        form.addEventListener("submit", function () {
          var submit = document.getElementById("cc-form-submit");
          if (!submit) return;
          submit.disabled = true;
          submit.textContent = "Enviando…";
        });
      }
    }

    var fine = window.matchMedia("(pointer: fine)").matches;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Tutores: spotlight que sigue el cursor
    if (fine) {
      document.querySelectorAll(".esic-curso-claude .cc-tutor").forEach(function (c) {
        c.addEventListener("mousemove", function (e) {
          var r = c.getBoundingClientRect();
          c.style.setProperty("--sx", ((e.clientX - r.left) / r.width) * 100 + "%");
          c.style.setProperty("--sy", ((e.clientY - r.top) / r.height) * 100 + "%");
        });
      });
    }

    // Mascota: parallax al mouse dentro de la seccion de pilares
    var wrap = document.getElementById("cc-mascot-wrap");
    if (wrap && fine && !reduced) {
      var eco = wrap.closest("section");
      eco.addEventListener("mousemove", function (e) {
        var r = eco.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        wrap.style.transform = "translate(" + dx * 26 + "px, " + dy * 14 + "px) rotate(" + dx * 4 + "deg)";
      });
      eco.addEventListener("mouseleave", function () { wrap.style.transform = ""; });
      wrap.style.transition = "transform 0.25s ease-out";
    }

    // Cierre: sparkles alrededor del precio
    var price = document.getElementById("cc-price-final");
    if (price && !reduced) {
      for (var i = 0; i < 10; i++) {
        var s = document.createElement("span");
        s.className = "cc-sparkle";
        s.style.left = (-8 + Math.random() * 116) + "%";
        s.style.top = (-30 + Math.random() * 160) + "%";
        s.style.animationDelay = Math.random() * 2 + "s";
        s.style.transform = "scale(" + (0.5 + Math.random()) + ")";
        price.appendChild(s);
      }
    }
  })();
</script>


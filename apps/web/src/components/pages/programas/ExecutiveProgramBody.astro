---
/**
 * ExecutiveProgramBody — cuerpo compartido del Executive Program
 * "Human AI-First Leadership" (antes "Digital Business Transformation").
 *
 * Contiene todo lo que va DESPUÉS del hero (idéntico en ambas páginas):
 *  - Stats bar (4 / Madrid / $30.345.000 / 2h)
 *  - Propósito + pilares
 *  - Información General (4 columnas, fondo azul)
 *  - Estructura del Programa (3 módulos + highlight Madrid)
 *  - Cocreadores (ESIC · Prestigio · Accenture)
 *  - Metodología (círculos dorados + DMLA + categorías + barra internacional)
 *  - CTA final: quote de Juan Manuel Jiménez + (opcional) formulario de captura
 *
 * El acento de Executive es AZUL (#0047E9); la metodología usa dorado (#C09C2E)
 * tal como en el original. Los estilos son scoped (Astro) — markup 1:1.
 *
 * withForm: convierte el CTA de cierre en la estructura de las demás páginas
 * (copy a la izquierda + tarjeta con formulario a la derecha) y añade la
 * descarga del brochure. La quote y el celular de JuanMa se conservan al lado.
 */
import { asset } from "../../../lib/assets";
import ExecutiveContactForm from "./ExecutiveContactForm.astro";

interface Props {
  withForm?: boolean;
}
const { withForm = false } = Astro.props;

/**
 * Brochure oficial del programa.
 * Fuente: SharePoint Marketing → DISEÑO/Brochure/CORPORATE/EP 2026/
 * "2026 Executive Program.pdf". Ya está subido al bucket de assets con ese
 * mismo nombre (con espacios, de ahí el %20).
 */
const BROCHURE_URL = asset("wp/2026/08/2026%20Executive%20Program.pdf");

/**
 * Franja "Información General" (fechas / inmersión / duración / inversión).
 *
 * APAGADA a pedido de Comercial (12/08/2026): todavía no se saben las fechas de
 * la nueva cohorte y la franja gira alrededor de ellas. Para volver a prenderla
 * cuando haya fechas: poner `true` y actualizar los datos de la sección.
 *
 * La inversión, Madrid y los 4 meses siguen visibles en la barra de stats.
 */
const SHOW_INFO_GENERAL = false;

/**
 * Sección "Metodología" (círculos + DMLA + tipos de sesión).
 * APAGADA a pedido de Comercial (13/08/2026). Para volver a mostrarla, poner
 * `true`: el markup y los estilos siguen aquí.
 */
const SHOW_METODOLOGIA = false;

/**
 * Claustro internacional. Las fotos vienen del documento de Marketing
 * ("Revisión LANDING ExP.docx"): retrato circular en blanco y negro con la
 * bandera del país incrustada, recortado a PNG con fondo transparente.
 * Son de baja resolución (≈440px), por eso la tarjeta se mantiene pequeña.
 */
const DOCENTES = [
  {
    nombre: "Claudia Zapico",
    cargo: "Experta en Transformación y Liderazgo · Prestigio & CLA Consulting",
    foto: asset("wp/2026/08/docentes/claudia-zapico.webp"),
  },
  {
    nombre: "Fernando “Bana” Benegas",
    cargo: "Partner de Bleett · Ex Secretario de Innovación y Transformación Digital, Ciudad de Buenos Aires",
    foto: asset("wp/2026/08/docentes/fernando-benegas.webp"),
  },
  {
    nombre: "Juan Esteban Jaramillo",
    cargo: "Presidente ESIC Medellín · Fundador Fugaku Digital · Ex-VP Administrativo Grupo Familia",
    foto: asset("wp/2026/08/docentes/juan-esteban-jaramillo.webp"),
  },
  {
    nombre: "Eva Cerrolaza",
    cargo: "Directora I+D Prestigio",
    foto: asset("wp/2026/08/docentes/eva-cerrolaza.webp"),
  },
  {
    nombre: "Esteban Betancur",
    cargo: "Presidente Prestigio",
    foto: asset("wp/2026/08/docentes/esteban-betancur.webp"),
  },
  {
    nombre: "Ignacio Martín",
    cargo: "Consultor Prestigio & CLA Consulting",
    foto: asset("wp/2026/08/docentes/ignacio-martin.webp"),
  },
  {
    nombre: "Francisco “Curro” López",
    cargo: "Global Head of Talent Acquisition & Employer Branding en PagoNxt",
    foto: asset("wp/2026/08/docentes/francisco-lopez.webp"),
  },
];
---
<!-- Stats Bar -->
<div class="exec__container" style="position:relative; z-index:12;">
  <div class="exec__stats-bar">
    <div class="exec__stat-item">
      <div class="exec__stat-number">4</div>
      <div class="exec__stat-label">Meses de duración</div>
    </div>
    <div class="exec__stat-item">
      <div class="exec__stat-number">MADRID</div>
      <div class="exec__stat-label">Inmersión internacional</div>
    </div>
    <div class="exec__stat-item">
      <div class="exec__stat-number">$30.345.000</div>
      <div class="exec__stat-label">COP Inversión (IVA incluido)</div>
    </div>
    <div class="exec__stat-item">
      <div class="exec__stat-number">2h</div>
      <div class="exec__stat-label">Dedicación semanal</div>
    </div>
  </div>
</div>

<!-- Propósito -->
<section class="exec__proposito exec__overlap">
  <div class="exec__container">
    <div class="exec__proposito-grid">
      <div>
        <h2>PROPÓSITO DEL PROGRAMA</h2>
        <p>Impulsar a altos ejecutivos a evolucionar su liderazgo para transformar sus organizaciones en la era de la inteligencia artificial, integrando estrategia, innovación y tecnología con criterio humano, y desarrollando las capacidades y la cultura necesarias para crear valor, fortalecer la competitividad y generar un impacto sostenible.</p>
      </div>
      <div>
        <div class="exec__pilares">
          <div class="exec__pilar">
            <div class="exec__pilar-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <span>Liderazgo y cultura</span>
          </div>
          <div class="exec__pilar">
            <div class="exec__pilar-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <span>Tecnologías Emergentes</span>
          </div>
          <div class="exec__pilar">
            <div class="exec__pilar-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                <polyline points="2 17 12 22 22 17"/>
                <polyline points="2 12 12 17 22 12"/>
              </svg>
            </div>
            <span>Innovación estratégica</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Beneficios: "Este Executive Program" -->
    <div class="exec__beneficios">
      <h3>Este Executive Program</h3>
      <ul>
        <li>Prepara a los participantes para anticiparse a los cambios y aprovechar las oportunidades digitales.</li>
        <li>Impulsa la capacidad de diseñar estrategias competitivas en entornos de alta disrupción.</li>
        <li>Fortalece la visión global para conectar negocios tradicionales con la nueva economía digital.</li>
        <li>Genera competencias clave para transformar modelos de negocio y crear valor sostenible.</li>
        <li>Potencia la mentalidad de cambio y la capacidad de ejecución en escenarios complejos.</li>
        <li>Promueve la construcción de redes de alto valor entre directivos de diferentes sectores.</li>
      </ul>
    </div>
  </div>
</section>

<!-- Información General -->
{SHOW_INFO_GENERAL && (
<section class="exec__info exec__overlap">
  <div class="exec__container">
    <h2>INFORMACIÓN GENERAL</h2>
    <div class="exec__info-row">
      <div class="exec__info-col">
        <div class="exec__info-col-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <h3>Fechas</h3>
        <p><strong>Inicio:</strong> martes 2 de junio 2026<br /><strong>Fin:</strong> viernes 2 de octubre 2026</p>
      </div>
      <div class="exec__info-col">
        <div class="exec__info-col-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <h3>Inmersión internacional</h3>
        <p><strong>Madrid — 4 días</strong><br />29 de septiembre a 2 de octubre 2026</p>
      </div>
      <div class="exec__info-col">
        <div class="exec__info-col-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3>Duración</h3>
        <p><strong>4 meses · 2h por semana</strong><br />Jueves de 7:00 a 9:00 a.m.<br />2 sesiones presenciales</p>
      </div>
      <div class="exec__info-col exec__info-col--precio">
        <div class="exec__info-col-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="1" x2="12" y2="23"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <h3>Inversión</h3>
        <div class="exec__precio">$30.345.000</div>
        <p class="exec__nota">IVA incluido. No incluye tiquetes ni hospedaje en Madrid.</p>
      </div>
    </div>
  </div>
</section>
)}

<!-- Estructura del Programa.
     Sin la franja azul de Información General, Propósito y Estructura quedarían
     los dos en crema y el escalonado de secciones no se vería: se alternan los
     fondos (Estructura en blanco, Cocreadores en crema). -->
<section class:list={["exec__estructura", "exec__overlap", !SHOW_INFO_GENERAL && "exec__estructura--alt"]}>
  <div class="exec__container">
    <h2>ESTRUCTURA DEL PROGRAMA</h2>

    <!-- El kick-off es transversal, por eso va aparte y antes del módulo 1 -->
    <div class="exec__kickoff">
      <div class="exec__kickoff-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91 0z"/>
          <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
          <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
        </svg>
      </div>
      <div>
        <span class="exec__kickoff-tag"><span class="exec__badge-p">Presencial</span></span>
        <h3>Kick-off</h3>
      </div>
    </div>

    <div class="exec__modulos-grid">
      <!-- Liderazgo y Cultura -->
      <div class="exec__modulo-col">
        <span class="exec__modulo-badge">Módulo 1</span>
        <h3>Liderazgo y cultura</h3>
        <ul>
          <li>Nuevos tiempos, nuevos desafíos</li>
          <li>Liderazgo en la era de la IA</li>
          <li>Experiencia de Liderazgo <span class="exec__badge-p">Presencial</span></li>
          <li>Caso con protagonista</li>
          <li>Peer mentoring</li>
        </ul>
      </div>
      <!-- Tecnologías Emergentes -->
      <div class="exec__modulo-col">
        <span class="exec__modulo-badge">Módulo 2</span>
        <h3>Tecnologías emergentes</h3>
        <ul>
          <li>IA en acción: tendencias, casos y posibilidades</li>
          <li>Blockchain</li>
          <li>Gobernanza de IA</li>
          <li>Workshop IA <span class="exec__badge-p">Presencial</span></li>
          <li>Caso con protagonista</li>
        </ul>
      </div>
      <!-- Innovación Estratégica -->
      <div class="exec__modulo-col">
        <span class="exec__modulo-badge">Módulo 3</span>
        <h3>Innovación estratégica</h3>
        <ul>
          <li>Innovación estratégica I</li>
          <li>Innovación estratégica II</li>
          <li>Caso con protagonista</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Experiencia Internacional — antes estaba duplicada (barra al final de
     Estructura + barra al final de Metodología). Ahora es una sola sección,
     con el protagonismo que pidió Comercial. -->
<section class="exec__intl exec__overlap">
  <div class="exec__container">
    <div class="exec__intl-grid">
      <div>
        <div class="exec__spain-flag">
          <div class="exec__stripe-red"></div>
          <div class="exec__stripe-yellow"></div>
          <div class="exec__stripe-red"></div>
        </div>
        <h2>EXPERIENCIA INTERNACIONAL</h2>
      </div>
      <ul class="exec__intl-list">
        <li>Inmersión de 4 días en Madrid, España</li>
        <li>Sesiones académicas con docentes internacionales</li>
        <li>Visitas empresariales de alto nivel</li>
        <li>Experiencias sociales y culturales</li>
      </ul>
    </div>
  </div>
</section>

<!-- Cocreadores -->
<section class:list={["exec__cocreadores", "exec__overlap", !SHOW_INFO_GENERAL && "exec__cocreadores--alt"]}>
  <div class="exec__container">
    <h2>Programa cocreado por</h2>
    <div class="exec__logos-row">
      <div class="exec__logo-item exec__logo-esic">
        <img src={asset("wp/2026/02/logo-esic.png")} alt="ESIC Business &amp; Marketing School" />
      </div>
      <div class="exec__logo-item exec__logo-prestigio">
        <img src={asset("wp/2026/02/logo-prestigio.png")} alt="Prestigio" />
      </div>
      <div class="exec__logo-item exec__logo-accenture">
        <img src={asset("wp/2026/02/logo-accenture.png")} alt="Accenture" />
      </div>
    </div>
  </div>
</section>

<!-- Metodología -->
{SHOW_METODOLOGIA && (
<section class="exec__metodologia exec__overlap">
  <div class="exec__metodologia-header">
    <h2>METODOLOGÍA:</h2>
  </div>

  <div class="exec__metodologia-circles">
    <div class="exec__metodologia-circles-container">
      <div class="exec__metodologia-curve">
        <svg viewBox="0 0 800 60" preserveAspectRatio="none">
          <path d="M0,30 Q200,0 400,30 T800,30" />
        </svg>
      </div>

      <div class="exec__metodologia-circle-item">
        <div class="exec__metodologia-circle"><span>Liderazgo<br />y cultura</span></div>
      </div>

      <span class="exec__metodologia-plus">+</span>

      <div class="exec__metodologia-circle-item">
        <div class="exec__metodologia-circle"><span>Tecnologías<br />emergentes</span></div>
      </div>

      <span class="exec__metodologia-plus">+</span>

      <div class="exec__metodologia-circle-item">
        <div class="exec__metodologia-circle"><span>Innovación<br />estratégica</span></div>
      </div>
    </div>
  </div>

  <div class="exec__metodologia-dmla">
    <h3>DMLA</h3>
    <p>(Digital Maturity &amp; Leadership Assessment)</p>
  </div>

  <div class="exec__metodologia-categories">
    <div class="exec__cat-item"><span>MASTERCLASSES</span></div>
    <div class="exec__cat-item"><span>CASOS CON PROTAGONISTA</span></div>
    <div class="exec__cat-item"><span>MENTORÍAS INDIVIDUALES</span></div>
    <div class="exec__cat-item"><span>EXPERIENCIAS PRESENCIALES</span></div>
  </div>

  <!-- La barra de Experiencia Internacional que iba aquí se unificó con la
       sección propia (arriba): antes el bloque estaba repetido. -->
</section>
)}

<!-- Docentes internacionales -->
<section class:list={["exec__docentes", "exec__overlap", !SHOW_METODOLOGIA && "exec__docentes--alt"]}>
  <div class="exec__container">
    <span class="exec__docentes-kicker">Claustro</span>
    <h2>DOCENTES INTERNACIONALES</h2>
    <div class="exec__docentes-grid">
      {DOCENTES.map((d) => (
        <article class="exec__docente">
          <img src={d.foto} alt={d.nombre} loading="lazy" width="110" height="110" />
          <h3>{d.nombre}</h3>
          <p>{d.cargo}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CTA de cierre: quote + (opcional) formulario de captura -->
<section class="exec__quote-cta exec__overlap" id="contacto">
  <div class="exec__container">
    {withForm ? (
      <div class="exec__cta-grid">
        <div class="exec__cta-copy">
          <blockquote>"ES MOMENTO DE TRANSFORMAR,<br /><em>no de adaptarse.</em><br />Tú marcas la diferencia"</blockquote>
          <div class="exec__quote-divider"></div>
          <h3>JUAN MANUEL JIMÉNEZ</h3>
          <p class="exec__cargo">Director Comercial ESIC Medellín</p>
          <a class="exec__telefono" href="tel:+573042364804">+57 304 2364804</a>

          <a
            class="exec__brochure"
            href={BROCHURE_URL}
            target="_blank"
            rel="noopener"
            download
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Descargar brochure
          </a>
        </div>

        <div class="exec__cta-card">
          <span class="exec__cta-kicker">Solicita información</span>
          <h4>Déjanos tus datos</h4>
          <p class="exec__cta-lead">Un asesor te contacta con el detalle del programa, fechas, formas de pago y la inmersión en Madrid.</p>
          <ExecutiveContactForm idPrefix="exec-dbt" />
        </div>
      </div>
    ) : (
      <div class="exec__cta-copy exec__cta-copy--solo">
        <blockquote>"ES MOMENTO DE TRANSFORMAR,<br /><em>no de adaptarse.</em><br />Tú marcas la diferencia"</blockquote>
        <div class="exec__quote-divider"></div>
        <h3>JUAN MANUEL JIMÉNEZ</h3>
        <p class="exec__cargo">Director Comercial ESIC Medellín</p>
        <a class="exec__telefono" href="tel:+573042364804">+57 304 2364804</a>
      </div>
    )}
  </div>
</section>

<style>
  /* ── Tokens locales (réplica del original) ── */
  .exec__container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  /* ── Stats Bar ── */
  .exec__stats-bar {
    background: #fff;
    border-radius: 24px;
    padding: 2.5rem 3rem;
    margin-top: -50px;
    position: relative;
    z-index: 10;
    box-shadow: 0 20px 60px rgba(0,19,63,0.12);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .exec__stat-item { text-align: center; }
  .exec__stat-number {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: #0047E9;
    line-height: 1;
  }
  .exec__stat-label {
    font-size: 0.8rem;
    color: #5F6B7A;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.4rem;
  }

  /* ── Overlap pattern ── */
  .exec__overlap {
    position: relative;
    margin-top: -50px;
    border-radius: 50px 50px 0 0;
  }

  /* ── Propósito ── */
  .exec__proposito {
    margin-top: -100px;
    padding: 10rem 0 7rem;
    background: #F5F3EF;
    z-index: 2;
  }
  .exec__proposito-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .exec__proposito h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #00133F;
    margin-bottom: 1.5rem;
  }
  .exec__proposito p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #5F6B7A;
    margin: 0;
  }
  .exec__pilares {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }
  /* El ícono va en caja chica y sin fondo sólido: antes el cuadro azul pesaba
     más que el propio nombre del pilar. */
  /* Sin borde lateral: con las esquinas redondeadas dejaba una media luna azul
     colgando en el borde de la pastilla. */
  .exec__pilar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.4rem;
    background: #fff;
    border-radius: 14px;
  }
  .exec__pilar-icon {
    width: 26px;
    height: 26px;
    min-width: 26px;
    display: grid;
    place-items: center;
    color: #0047E9;
  }
  .exec__pilar-icon svg { width: 24px; height: 24px; }
  .exec__pilar span {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #00133F;
  }

  /* ── Beneficios ── */
  .exec__beneficios {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(0,19,63,0.1);
  }
  .exec__beneficios h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #00133F;
    margin: 0 0 2rem;
  }
  .exec__beneficios ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .exec__beneficios li {
    position: relative;
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem 1.5rem 1.5rem 3.4rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #3C4858;
  }
  .exec__beneficios li::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    top: 1.85rem;
    width: 14px;
    height: 8px;
    border-left: 2.5px solid #0047E9;
    border-bottom: 2.5px solid #0047E9;
    transform: rotate(-45deg);
  }

  /* ── Info General ── */
  .exec__info {
    padding: 6rem 0 7rem;
    background: #0047E9;
    z-index: 3;
  }
  .exec__info h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #fff;
    text-align: center;
    margin-bottom: 3rem;
  }
  /* Tarjetas en vez de 4 columnas suelta: cada dato queda contenido, con la
     misma altura y el mismo ritmo vertical (antes se leía desalineado). */
  .exec__info-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }
  .exec__info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    padding: 2rem 1.5rem;
    border-radius: 20px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.16);
  }
  .exec__info-col-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: rgba(255,255,255,0.12);
    color: #fff;
    margin-bottom: 1.1rem;
  }
  .exec__info-col-icon svg { width: 26px; height: 26px; stroke: #fff; }
  .exec__info-col h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: #fff;
    margin: 0 0 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    width: 100%;
  }
  .exec__info-col p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.82);
    margin: 0;
  }
  .exec__info-col p strong { color: #fff; font-weight: 600; }
  .exec__info-col .exec__precio {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 2.4rem;
    font-weight: 800;
    color: #0AE4C3;
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .exec__info-col .exec__nota {
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.62);
    margin-top: auto;
  }

  /* ── Estructura ── */
  .exec__estructura {
    padding: 6rem 0 7rem;
    background: #F5F3EF;
    z-index: 4;
  }
  .exec__estructura h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #00133F;
    text-align: center;
    margin-bottom: 3rem;
  }
  /* Fondos alternos cuando no hay franja de Información General */
  section.exec__estructura--alt { background: #fff; }
  section.exec__estructura--alt .exec__modulo-col {
    background: #F5F3EF;
    border: 1px solid rgba(0,19,63,0.06);
  }
  /* section.* para ganarle al bloque .exec__cocreadores, que va más abajo */
  section.exec__cocreadores--alt { background: #F5F3EF; }

  .exec__modulos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .exec__modulo-col {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
  }
  .exec__modulo-badge {
    display: inline-block;
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    margin-bottom: 0.8rem;
    background: #0047E9;
  }
  .exec__modulo-col h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #00133F;
    margin-bottom: 0.6rem;
  }
  .exec__modulo-col ul { list-style: none; padding: 0; margin: 0; }
  .exec__modulo-col li {
    font-size: 0.82rem;
    color: #5F6B7A;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .exec__modulo-col li:last-child { border-bottom: none; }
  .exec__fecha {
    color: #97A2B1;
    white-space: nowrap;
    font-size: 0.75rem;
  }
  .exec__badge-p {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 50px;
    background: rgba(0,71,233,0.1);
    color: #0047E9;
    white-space: nowrap;
  }
  /* ── Kick-off (transversal, antes del módulo 1) ── */
  .exec__kickoff {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #0047E9;
    border-radius: 16px;
    padding: 1.4rem 1.8rem;
    margin-bottom: 1.5rem;
  }
  .exec__kickoff-icon {
    width: 46px;
    height: 46px;
    min-width: 46px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(255,255,255,0.15);
    color: #fff;
  }
  .exec__kickoff-icon svg { width: 24px; height: 24px; }
  .exec__kickoff-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.75);
  }
  .exec__kickoff-tag .exec__badge-p { background: rgba(255,255,255,0.2); color: #fff; }
  .exec__kickoff h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.9rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    color: #fff;
    margin: 0.3rem 0 0;
  }

  /* ── Experiencia Internacional ── */
  .exec__intl {
    padding: 5rem 0 6rem;
    background: linear-gradient(135deg, #8B7420 0%, #C09C2E 45%, #9A7A24 100%);
    z-index: 5;
  }
  .exec__intl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .exec__intl-kicker {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.85);
    margin-bottom: 0.6rem;
  }
  .exec__intl h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0,0,0,0.25);
  }
  .exec__intl-list { list-style: none; padding: 0; margin: 0; }
  .exec__intl-list li {
    position: relative;
    padding: 1rem 0 1rem 2.2rem;
    font-size: 1.02rem;
    line-height: 1.5;
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.25);
  }
  .exec__intl-list li:last-child { border-bottom: none; }
  .exec__intl-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 12px;
    height: 7px;
    border-left: 2.5px solid #fff;
    border-bottom: 2.5px solid #fff;
    transform: rotate(-45deg);
  }

  /* ── Docentes internacionales ── */
  /* Sin la Metodología (azul oscuro) antes, Cocreadores y Docentes quedarían
     los dos en crema y se perdería el escalonado: Docentes pasa a blanco. */
  section.exec__docentes--alt { background: #fff; }
  .exec__docentes {
    padding: 5rem 0 6rem;
    background: #F5F3EF;
    text-align: center;
    z-index: 8;
  }
  .exec__docentes-kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #0047E9;
    margin-bottom: 0.7rem;
  }
  .exec__docentes h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    color: #00133F;
    margin: 0 0 3rem;
  }
  /* Tarjeta chica a propósito: las fotos son de baja resolución.
     Fila centrada y no grilla: son 7, y en grilla de 4 la última fila quedaba
     coja contra la izquierda. */
  .exec__docentes-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  .exec__docente {
    flex: 0 1 260px;
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .exec__docente img {
    width: 110px;
    height: 110px;
    object-fit: contain;
    margin-bottom: 0.9rem;
  }
  .exec__docente h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    color: #00133F;
    margin: 0 0 0.4rem;
  }
  .exec__docente p {
    font-size: 0.8rem;
    line-height: 1.45;
    color: #5F6B7A;
    margin: 0;
  }

  .exec__madrid-highlight {
    background: #0047E9;
    border-radius: 12px;
    padding: 1.2rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .exec__madrid-highlight span {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
  }
  .exec__madrid-highlight .exec__fecha-m {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.7);
    font-weight: 400;
    font-family: "DM Sans", sans-serif;
    text-transform: none;
  }

  /* ── Cocreadores ── */
  .exec__cocreadores {
    padding: 5rem 0 6rem;
    background: #fff;
    text-align: center;
    z-index: 6;
  }
  .exec__cocreadores h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #5F6B7A;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
  }
  /* Los tres logos vienen del mismo lienzo (800×350) con la marca centrada, así
     que a igual altura de lienzo quedan alineados y a la misma escala óptica.
     Se pintan en negro sólido: los originales son azul, verde petróleo y negro
     con flecha morada, y juntos en blanco desentonaban. */
  .exec__logos-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    flex-wrap: wrap;
  }
  .exec__logo-item { display: flex; align-items: center; justify-content: center; }
  .exec__logo-item img {
    height: 84px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) saturate(0);
    opacity: 0.88;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .exec__logo-item img:hover { opacity: 1; transform: translateY(-2px); }
  /* Accenture ocupa más alto de lienzo (lleva la flecha encima del wordmark). */
  .exec__logo-accenture img { height: 78px; }

  /* ── Metodología ── */
  /* padding-bottom: la barra de categorías quedó siendo el último bloque de la
     sección (antes iba la de Experiencia Internacional) y el overlap de -50px
     de la sección siguiente se la comía. */
  .exec__metodologia {
    padding: 0 0 6rem;
    background: #00133F;
    position: relative;
    z-index: 7;
  }
  .exec__metodologia-header {
    background: linear-gradient(90deg, #8B7420 0%, #C09C2E 50%, #8B7420 100%);
    padding: 1rem 2rem;
    text-align: center;
  }
  .exec__metodologia-header h2 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 800;
    text-transform: uppercase;
    color: #00133F;
    letter-spacing: 0.15em;
    margin: 0;
  }
  .exec__metodologia-circles { padding: 4rem 2rem 3rem; position: relative; }
  .exec__metodologia-circles-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }
  .exec__metodologia-curve {
    position: absolute;
    top: 50%;
    left: 10%;
    right: 10%;
    height: 60px;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 0;
  }
  .exec__metodologia-curve svg { width: 100%; height: 100%; }
  .exec__metodologia-curve path { fill: none; stroke: #C09C2E; stroke-width: 3; }
  .exec__metodologia-circle-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 1;
    flex: 1;
  }
  .exec__metodologia-circle {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C09C2E 0%, #9A7A24 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(192,156,46,0.3), inset 0 2px 4px rgba(255,255,255,0.2);
    position: relative;
  }
  .exec__metodologia-circle span {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    font-weight: 800;
    text-transform: uppercase;
    color: #fff;
    text-align: center;
    line-height: 1.2;
    padding: 0 0.5rem;
  }
  .exec__metodologia-plus {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0.5rem;
    position: relative;
    z-index: 1;
  }
  .exec__metodologia-dmla { text-align: center; padding: 0 2rem 3rem; }
  .exec__metodologia-dmla h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    margin: 0;
    letter-spacing: 0.1em;
  }
  .exec__metodologia-dmla p {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    color: rgba(255,255,255,0.8);
    margin: 0.5rem 0 0;
  }
  .exec__metodologia-categories {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    padding: 2.5rem 2rem;
    border-top: 1px solid rgba(192,156,46,0.2);
    border-bottom: 1px solid rgba(192,156,46,0.2);
  }
  .exec__cat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2rem;
    position: relative;
  }
  .exec__cat-item:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 70%;
    width: 1px;
    background: rgba(192,156,46,0.5);
  }
  .exec__cat-item span {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(0.75rem, 1.5vw, 0.95rem);
    font-weight: 700;
    text-transform: uppercase;
    color: #C09C2E;
    letter-spacing: 0.08em;
    text-align: center;
    white-space: nowrap;
  }
  .exec__intl-bar {
    background: linear-gradient(135deg, #8B7420 0%, #C09C2E 30%, #9A7A24 70%, #8B7420 100%);
    padding: 3rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .exec__intl-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    animation: execShimmer 3s infinite;
  }
  @keyframes execShimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .exec__spain-flag {
    display: flex;
    flex-direction: column;
    width: 200px;
    margin: 0 auto 1.5rem;
    position: relative;
    z-index: 1;
  }
  .exec__stripe-red { height: 4px; background: #AA151B; }
  .exec__stripe-yellow { height: 8px; background: #F1BF00; }
  .exec__intl-bar h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: 0.15em;
    margin: 0;
    position: relative;
    z-index: 1;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }
  .exec__intl-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    margin-top: 0.8rem;
    position: relative;
    z-index: 1;
  }

  /* ── CTA de cierre ── */
  .exec__quote-cta {
    padding: 6rem 0;
    background: #00133F;
    color: #fff;
    text-align: center;
    z-index: 9;
  }
  /* Con formulario: copy a la izquierda, tarjeta blanca a la derecha (misma
     estructura que el resto de páginas de programa). */
  .exec__cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    text-align: left;
  }
  .exec__cta-grid .exec__cta-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .exec__cta-copy--solo { text-align: center; }
  .exec__quote-cta blockquote {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.95;
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }
  .exec__cta-grid blockquote,
  .exec__cta-grid .exec__quote-divider { margin-left: 0; }

  /* Brochure */
  .exec__brochure {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
    padding: 0.85rem 1.6rem;
    border: 2px solid rgba(255,255,255,0.45);
    border-radius: 50px;
    font-family: "DM Sans", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }
  .exec__brochure svg { width: 16px; height: 16px; }
  .exec__brochure:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.08);
    transform: translateY(-2px);
  }

  /* Tarjeta del formulario */
  .exec__cta-card {
    background: #fff;
    border-radius: 24px;
    padding: 2.5rem;
    text-align: left;
    box-shadow: 0 24px 70px rgba(0,0,0,0.28);
  }
  .exec__cta-kicker {
    display: block;
    font-family: "DM Sans", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #0047E9;
    margin-bottom: 0.6rem;
  }
  .exec__cta-card h4 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 2.1rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    color: #00133F;
    margin: 0 0 0.6rem;
  }
  .exec__cta-lead {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #5F6B7A;
    margin: 0 0 1.8rem;
  }
  .exec__quote-cta blockquote em { font-style: normal; color: #0AE4C3; }
  .exec__quote-divider {
    width: 50px;
    height: 2px;
    background: rgba(255,255,255,0.3);
    margin: 0 auto 2rem;
  }
  .exec__quote-cta h3 {
    font-family: "Sofia Sans Extra Condensed", sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

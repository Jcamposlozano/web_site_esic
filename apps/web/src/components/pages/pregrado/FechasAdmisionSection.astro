---
/**
 * Fechas clave del proceso de admisión de pregrado.
 *
 * Fuente: correo de Eliana Monsalve (liderpregrados@esic.co) del 30/07/2026,
 * "Fechas pregrado 2026.2" — cohorte de enero 2027.1.
 *
 * Se reutiliza en /pregrado y en las dos páginas de programa
 * (Digital Business y Dirección de Marketing Global).
 */
import Container from "../../Container.astro";

interface Props {
  /** Índice de apilado para el efecto de solape. */
  z?: number;
  /** Clase de fondo (Tailwind). */
  bg?: string;
}

const { z = 1, bg = "bg-white" } = Astro.props;

const hitos = [
  {
    fecha: "10 de agosto",
    anio: "2026",
    titulo: "Apertura del proceso de admisión",
    detalle: "Comienza la recepción de solicitudes para la cohorte de enero de 2027.",
    icon: '<path d="M8 2v4M16 2v4M3 10h18"></path><rect x="3" y="4" width="18" height="18" rx="2"></rect>',
    destacado: false,
  },
  {
    fecha: "30 de octubre",
    anio: "2026",
    titulo: "Cierre de matrícula prioritaria",
    detalle: "Última fecha para asegurar tu cupo bajo las condiciones de matrícula prioritaria.",
    icon: '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>',
    destacado: true,
  },
  {
    fecha: "30 de noviembre",
    anio: "2026",
    titulo: "Cierre del proceso de admisión",
    detalle: "Fecha límite para completar tu solicitud de ingreso a la cohorte de enero de 2027.",
    icon: '<path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>',
    destacado: false,
  },
];
---

<section
  class:list={[
    "relative -mt-[50px] rounded-t-[50px] py-16 md:py-24",
    bg,
  ]}
  style={`z-index: ${z};`}
  id="fechas-admision"
>
  <Container>
    <div class="mb-10 md:mb-14 max-w-[640px]">
      <span class="inline-flex items-center gap-3 text-[0.9rem] font-display font-extrabold uppercase tracking-[0.2em] text-brand-orange">
        <span class="block h-0.5 w-6 bg-current" aria-hidden="true"></span>
        Admisiones abiertas
      </span>
      <h2 class="font-display text-[clamp(2.5rem,5vw,4.2rem)] font-extrabold uppercase leading-[0.95] text-brand-blue-dark mt-3 mb-3">
        Fechas clave<br />cohorte enero 2027
      </h2>
      <p class="text-ink-muted text-[1.05rem]">
        Estas son las fechas del proceso de admisión para quienes inician su pregrado en enero de 2027.
      </p>
    </div>

    <ol class="grid gap-6 md:grid-cols-3 list-none p-0 m-0">
      {hitos.map((h) => (
        <li
          class:list={[
            "relative rounded-[20px] p-7 border-l-4 h-full flex flex-col",
            h.destacado
              ? "bg-brand-blue-dark text-white border-brand-orange shadow-[0_20px_50px_rgba(0,19,63,0.25)]"
              : "bg-surface text-brand-blue-dark border-brand-orange/40 shadow-[0_20px_50px_rgba(0,19,63,0.12)]",
          ]}
        >
          <div
            class:list={[
              "w-10 h-10 rounded-[12px] grid place-items-center mb-5",
              h.destacado ? "bg-white/15 text-white" : "bg-brand-orange/10 text-brand-orange",
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
              aria-hidden="true"
              set:html={h.icon}
            ></svg>
          </div>
          <div
            class:list={[
              "font-display text-[clamp(1.8rem,3.5vw,2.4rem)] font-extrabold uppercase leading-none",
              h.destacado ? "text-brand-orange" : "text-brand-orange",
            ]}
          >
            {h.fecha}
          </div>
          <div
            class:list={[
              "text-[0.85rem] uppercase tracking-[0.12em] mb-4",
              h.destacado ? "text-white/70" : "text-ink-muted",
            ]}
          >
            {h.anio}
          </div>
          <h3
            class:list={[
              "font-display text-[1.1rem] font-extrabold uppercase mb-2 leading-tight",
              h.destacado ? "text-white" : "text-brand-blue-dark",
            ]}
          >
            {h.titulo}
          </h3>
          <p
            class:list={[
              "text-[0.95rem] leading-relaxed m-0",
              h.destacado ? "text-white/80" : "text-ink-muted",
            ]}
          >
            {h.detalle}
          </p>
        </li>
      ))}
    </ol>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#formulario"
        class="inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 font-semibold text-[0.95rem] no-underline transition-all hover:-translate-y-0.5 bg-brand-orange text-white hover:bg-brand-blue-dark"
      >
        Inicia tu proceso de admisión
      </a>
    </div>
  </Container>
</section>

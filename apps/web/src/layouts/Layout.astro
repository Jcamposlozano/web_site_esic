---
import "../styles/global.css";
import Nav from "../components/Nav.tsx";
import Footer from "../components/Footer.astro";
import BlueChatWidget from "../components/BlueChatWidget.astro";
import { asset } from "../lib/assets";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /**
   * Si la página tiene hero full-bleed (como el home con el carrusel),
   * pásalo true para que el nav flote por encima del primer contenido.
   * Las páginas normales reservan padding-top para no quedar tapadas.
   */
  fullBleed?: boolean;
  /** Oculta el footer global (p.ej. páginas internas de /dev). */
  hideFooter?: boolean;
}

const {
  title,
  description = "ESIC Business &amp; Marketing School Medell&iacute;n — pregrados, m&aacute;ster y educaci&oacute;n ejecutiva.",
  image = asset("og/og-default.jpg"),
  fullBleed = false,
  hideFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-N9JPKF6');</script>
    <!-- End Google Tag Manager -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Sofia+Sans+Extra+Condensed:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[!fullBleed && "pt-24"]}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N9JPKF6"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav client:load />
    <slot />
    {!hideFooter && <Footer />}
    {!hideFooter && <BlueChatWidget />}
  </body>
</html>
